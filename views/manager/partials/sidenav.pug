  // begin:: Aside Menu
  #kt_aside_menu_wrapper.kt-aside-menu-wrapper.kt-grid__item.kt-grid__item--fluid
    #kt_aside_menu.kt-aside-menu(data-ktmenu-vertical="1" data-ktmenu-scroll="1" data-ktmenu-dropdown-timeout="500")
      ul.kt-menu__nav

        // Dashboard
        li.kt-menu__item(aria-haspopup="true", class=(pageTitle === "Dashboard" ? "kt-menu__item--active" : ""))
          a.kt-menu__link(href="/manager")
            span.kt-menu__link-icon
              i.la.la-home
            span.kt-menu__link-text Dashboard

        // Billing
        li.kt-menu__section
          h4.kt-menu__section-text Billing
          i.kt-menu__section-icon.flaticon-more-v2

        li.kt-menu__item(aria-haspopup="true", class=(pageTitle === "New Bill" ? "kt-menu__item--active" : ""))
          a.kt-menu__link(href="/ma/billing")
            span.kt-menu__link-icon
              i.la.la-shopping-cart
            span.kt-menu__link-text New Bill

        li.kt-menu__item(aria-haspopup="true", class=(pageTitle === "Draft Bills" ? "kt-menu__item--active" : ""))
          a.kt-menu__link(href="/footwear/billing?status=DRAFT")
            span.kt-menu__link-icon
              i.la.la-file-text-o
            span.kt-menu__link-text Draft Bills

        li.kt-menu__item(aria-haspopup="true", class=(pageTitle === "Bill History" ? "kt-menu__item--active" : ""))
          a.kt-menu__link(href="/footwear/billing")
            span.kt-menu__link-icon
              i.la.la-list-alt
            span.kt-menu__link-text Bill History

        li.kt-menu__item(aria-haspopup="true", class=(pageTitle === "Returns / Cancelled" ? "kt-menu__item--active" : ""))
          a.kt-menu__link(href="/footwear/billing?status=CANCELLED")
            span.kt-menu__link-icon
              i.la.la-undo
            span.kt-menu__link-text Returns / Cancelled

        // Stock In
        li.kt-menu__section
          h4.kt-menu__section-text Stock In
          i.kt-menu__section-icon.flaticon-more-v2

        li.kt-menu__item(aria-haspopup="true", class=(pageTitle === "New Stock In" ? "kt-menu__item--active" : ""))
          a.kt-menu__link(href="/footwear/stock-in")
            span.kt-menu__link-icon
              i.la.la-plus-circle
            span.kt-menu__link-text New Stock In

        li.kt-menu__item(aria-haspopup="true", class=(pageTitle === "Draft Stock In Bills" ? "kt-menu__item--active" : ""))
          a.kt-menu__link(href="/footwear/stock-in?status=DRAFT")
            span.kt-menu__link-icon
              i.la.la-pencil-square-o
            span.kt-menu__link-text Draft Stock In Bills

        li.kt-menu__item(aria-haspopup="true", class=(pageTitle === "Confirmed Stock In Bills" ? "kt-menu__item--active" : ""))
          a.kt-menu__link(href="/footwear/stock-in?status=CONFIRMED")
            span.kt-menu__link-icon
              i.la.la-check-circle
            span.kt-menu__link-text Confirmed Stock In Bills

        li.kt-menu__item(aria-haspopup="true", class=(pageTitle === "Cancelled Stock In Bills" ? "kt-menu__item--active" : ""))
          a.kt-menu__link(href="/footwear/stock-in?status=CANCELLED")
            span.kt-menu__link-icon
              i.la.la-close
            span.kt-menu__link-text Cancelled Stock In Bills

        // Store Stock
        li.kt-menu__section
          h4.kt-menu__section-text Store Stock
          i.kt-menu__section-icon.flaticon-more-v2

        li.kt-menu__item(aria-haspopup="true", class=(pageTitle === "Current Stock" ? "kt-menu__item--active" : ""))
          a.kt-menu__link(href="/footwear/stockledger")
            span.kt-menu__link-icon
              i.la.la-cubes
            span.kt-menu__link-text Current Stock

        li.kt-menu__item(aria-haspopup="true", class=(pageTitle === "SKU Search" ? "kt-menu__item--active" : ""))
          a.kt-menu__link(href="/footwear/skus")
            span.kt-menu__link-icon
              i.la.la-search
            span.kt-menu__link-text SKU Search

        li.kt-menu__item(aria-haspopup="true", class=(pageTitle === "Low Stock" ? "kt-menu__item--active" : ""))
          a.kt-menu__link(href="/footwear/stockledger?view=low-stock")
            span.kt-menu__link-icon
              i.la.la-exclamation-triangle
            span.kt-menu__link-text Low Stock

        li.kt-menu__item(aria-haspopup="true", class=(pageTitle === "Damage / Shortage" ? "kt-menu__item--active" : ""))
          a.kt-menu__link(href="/footwear/damage-shortage")
            span.kt-menu__link-icon
              i.la.la-warning
            span.kt-menu__link-text Damage / Shortage

        // Customers / Parties
        li.kt-menu__section
          h4.kt-menu__section-text Customers / Parties
          i.kt-menu__section-icon.flaticon-more-v2

        li.kt-menu__item(aria-haspopup="true", class=(pageTitle === "Customers / Parties" ? "kt-menu__item--active" : ""))
          a.kt-menu__link(href="/footwear/parties")
            span.kt-menu__link-icon
              i.la.la-users
            span.kt-menu__link-text Customers / Parties

        // Day End
        li.kt-menu__section
          h4.kt-menu__section-text Day-End
          i.kt-menu__section-icon.flaticon-more-v2

        li.kt-menu__item(aria-haspopup="true", class=(pageTitle === "Day-End Closing" ? "kt-menu__item--active" : ""))
          a.kt-menu__link(href="/footwear/day-end")
            span.kt-menu__link-icon
              i.la.la-calendar-check-o
            span.kt-menu__link-text Day-End Closing

        // Tasks / Alerts
        li.kt-menu__section
          h4.kt-menu__section-text Tasks / Alerts
          i.kt-menu__section-icon.flaticon-more-v2

        li.kt-menu__item(aria-haspopup="true", class=(pageTitle === "Tasks / Alerts" ? "kt-menu__item--active" : ""))
          a.kt-menu__link(href="/footwear/tasks-alerts")
            span.kt-menu__link-icon
              i.la.la-bell
            span.kt-menu__link-text Tasks / Alerts
