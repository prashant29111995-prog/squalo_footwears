extends ./layout.pug

block styles
  style.
    .dashboard-actions {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }

    .dashboard-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: 11px 16px;
      border: 1px solid #4563e6;
      border-radius: 8px;
      background: #4563e6;
      color: #fff;
      font-size: 14px;
      font-weight: 700;
      text-align: center;
      text-decoration: none;
    }

    .dashboard-button:hover {
      border-color: #344ec6;
      background: #344ec6;
      color: #fff;
      text-decoration: none;
    }

    .dashboard-setup {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 20px;
      margin-bottom: 24px;
      border-color: #dbe4ff;
    }

    .dashboard-setup h2 {
      margin-bottom: 8px;
    }

    .dashboard-setup p {
      max-width: 640px;
      margin: 0;
    }

    .dashboard-section-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 16px;
    }

    .dashboard-section-head h2 {
      margin: 0;
    }

    .dashboard-empty {
      padding: 30px 20px;
      text-align: center;
    }

    .dashboard-empty p {
      max-width: 520px;
      margin: 10px auto 0;
    }

    .dashboard-table tbody tr:hover {
      background: #f8faff;
    }

    .dashboard-feature p {
      margin-bottom: 0;
    }

    .dashboard-footnote {
      margin: 14px 0 0;
      font-size: 12px;
      line-height: 1.6;
    }

    @media (max-width: 600px) {
      .dashboard-setup {
        align-items: stretch;
      }

      .dashboard-actions,
      .dashboard-button {
        width: 100%;
      }

      .metric-value {
        font-size: 25px;
      }
    }

block content
  .toolbar
    div
      h1 Outlet Dashboard
      .muted Stock and activity for your authorised outlet.

    if stores.length
      form.store-picker(
        action="/pos/dashboard"
        method="get"
      )
        div
          label(for="dashboardStore") Select Outlet

          select#dashboardStore(name="storeId")
            each store in stores
              option(
                value=String(store._id)
                selected=selectedStore && String(selectedStore._id) === String(store._id)
              ) #{store.code} — #{store.name}

        button.primary(type="submit") View Outlet

  if !selectedStore
    section.card.dashboard-empty
      h2 No Active Stores Assigned
      p.muted
        | Ask your administrator to link a store to this business
        |  and assign your membership to it.

  else
    - const canSetUpStock = ["OWNER", "MANAGER"].includes(role)
    - const setupUrl = "/pos/stores/" + String(selectedStore._id) + "/stock/setup"

    .notice
      strong= selectedStore.name
      |  · #{selectedStore.code} · #{selectedStore.type}

    if stock.negativeBatches > 0
      .notice.warning(role="alert")
        strong Stock Check Required
        |  — #{stock.negativeBatches} stock batches have negative balances.
        |  Review these before relying on availability.

    if canSetUpStock
      section.card.dashboard-setup
        div
          h2 Set Up Sizes & Rack Positions
          p.muted
            | Select an existing stock batch, enter physically counted
            |  sizes and racks, and classify front and basement locations.

        .dashboard-actions
          a.dashboard-button(href=setupUrl) Set Up Sizes & Racks

    .grid
      article.card
        .metric-label Current Stock
        .metric-value= stock.pairs
        .muted Net pairs recorded in the stock ledger.

      article.card
        .metric-label Available Stock Batches
        .metric-value= stock.batchCount
        .muted Article, colour, MRP and cost groups with positive stock.

      if canViewSales
        article.card
          .metric-label Today's Finalised Sales
          .metric-value= money(sales.amount)
          .muted Finalised bills dated today, in Indian time.

        article.card
          .metric-label Today's Bills / Pairs
          .metric-value #{sales.billCount} / #{sales.pairs}
          .muted Number of finalised bills and pairs on those bills.

    if canViewSales
      section.card.section
        .dashboard-section-head
          h2 Recent Finalised Bills
          span.status Latest 8

        if recentBills.length
          .table-wrap
            table.dashboard-table
              thead
                tr
                  th(scope="col") Bill
                  th(scope="col") Date
                  th.right(scope="col") Pairs
                  th.right(scope="col") Amount

              tbody
                each bill in recentBills
                  tr
                    td= bill.billNo || String(bill._id)
                    td= dateLabel(bill.billDate)
                    td.right= bill.totals ? bill.totals.qtyTotal : 0
                    td.right= money(bill.totals ? bill.totals.netTotal : 0)

          p.muted.dashboard-footnote
            | These figures reflect the existing finalised bill records.
            |  Payment collections, refunds and retail-versus-wholesale
            |  classification will be connected in the billing workflow.

        else
          .dashboard-empty
            h3 No Finalised Bills
            p.muted No finalised bills are recorded for this outlet.

    .grid
      article.card.dashboard-feature
        h3 Incoming Supplies
        span.status Not connected

        p.muted
          | Incoming dispatches, received quantities and shortages
          |  will appear here when the receipt workflow is connected.

      article.card.dashboard-feature
        h3 Front Rack Replenishment
        span.status Not connected

        p.muted
          | Refill lists will use verified size quantities,
          |  front-rack targets and available reserve stock.

      article.card.dashboard-feature
        h3 Staff Tasks
        span.status Not connected

        p.muted
          | Assigned picking, receiving and replenishment work
          |  will appear here when task tracking is connected.

    if canSetUpStock
      .notice.warning
        strong Before Verifying Stock
        |  — Stop legacy stock operations and allow existing requests
        |  to finish. The first verified allocation pauses legacy
        |  stock-writing workflows while migration is in progress.

    .notice
      strong POS Setup in Progress
      |  — Verified size-and-rack positions will support billing
      |  from the actual source rack. Sale, payment, receipt and
      |  return screens are the next implementation steps.