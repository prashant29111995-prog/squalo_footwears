doctype html
html(lang="en")
  include ../partials/head.pug

  style.
    tr.bill-final td { background-color:#f3fff7 !important; }
    tr.bill-final td:first-child { border-left:4px solid #22c55e; }

    tr.bill-draft td { background-color:#fffdf2 !important; }
    tr.bill-draft td:first-child { border-left:4px solid #f59e0b; }

    tr.bill-cancelled td { background-color:#fff5f5 !important; }
    tr.bill-cancelled td:first-child { border-left:4px solid #ef4444; }

    .badge-status {
      display:inline-block;
      padding:4px 10px;
      border-radius:999px;
      font-size:12px;
      font-weight:600;
      letter-spacing:.4px;
    }

    .badge-final { background:#dcfce7; color:#166534; }
    .badge-draft { background:#fef9c3; color:#854d0e; }
    .badge-cancelled { background:#fee2e2; color:#7f1d1d; }

    .summary-card {
      border:1px solid #edf0f7;
      border-radius:8px;
      padding:12px;
      background:#f9fafc;
    }

    .summary-label {
      font-size:12px;
      color:#74788d;
      margin-bottom:4px;
    }

    .summary-value {
      font-size:18px;
      font-weight:700;
      color:#2c2e3e;
    }

    .line-box {
      border:1px dashed #ccd4e0;
      border-radius:8px;
      background:#fbfcff;
      padding:14px;
      margin-bottom:16px;
    }

    .dropdown-menu.show-custom {
      display:block;
    }

    #billLinesTable td,
    #billLinesTable th {
      vertical-align:middle !important;
      white-space:nowrap;
    }

    #billLinesTable td:first-child {
      white-space:normal;
      min-width:220px;
      font-weight:600;
    }

  body.kt-quick-panel--right.kt-demo-panel--right.kt-offcanvas-panel--right.kt-header--fixed.kt-header-mobile--fixed.kt-subheader--enabled.kt-subheader--fixed.kt-subheader--solid.kt-aside--enabled.kt-aside--fixed.kt-page--loading

    #kt_header_mobile.kt-header-mobile.kt-header-mobile--fixed
      .kt-header-mobile__logo
        a(href="index.html")
          img(alt="Logo" src="/assets/media/logos/logo-dark.png")
      .kt-header-mobile__toolbar
        button#kt_aside_mobile_toggler.kt-header-mobile__toggler.kt-header-mobile__toggler--left
          span
        button#kt_header_mobile_toggler.kt-header-mobile__toggler
          span
        button#kt_header_mobile_topbar_toggler.kt-header-mobile__topbar-toggler
          i.flaticon-more

    .kt-grid.kt-grid--hor.kt-grid--root
      .kt-grid__item.kt-grid__item--fluid.kt-grid.kt-grid--ver.kt-page
        include ../partials/sidenav.pug

        #kt_wrapper.kt-grid__item.kt-grid__item--fluid.kt-grid.kt-grid--hor.kt-wrapper
          include ../partials/topnav.pug

          #kt_content.kt-content.kt-grid__item.kt-grid__item--fluid.kt-grid.kt-grid--hor
            include ../partials/header.pug

            .kt-container.kt-container--fluid.kt-grid__item.kt-grid__item--fluid
              .kt-portlet.kt-portlet--mobile
                .kt-portlet__head
                  .kt-portlet__head-label
                    h3.kt-portlet__head-title Billing
                      small.ml-2 Article → Color → Qty
                  .kt-portlet__head-toolbar
                    button.btn.btn-brand.btn-sm(type="button", data-toggle="modal", data-target="#modalBillCreate")
                      i.la.la-plus
                      |  Create Bill

                .kt-portlet__body(style="padding-top:0")
                  // DASHBOARD STATS
                  .row.mb-4
                    .col-md-2
                      .summary-card
                        .summary-label Today's Sales
                        .summary-value#stat_today_sales ₹0

                    .col-md-2
                      .summary-card
                        .summary-label This Month
                        .summary-value#stat_month_sales ₹0

                    .col-md-2
                      .summary-card
                        .summary-label Bills
                        .summary-value#stat_total_bills 0

                    .col-md-2
                      .summary-card
                        .summary-label Items Sold
                        .summary-value#stat_total_qty 0

                    .col-md-2
                      .summary-card
                        .summary-label Draft Bills
                        .summary-value#stat_draft_bills 0

                    .col-md-2
                      .summary-card
                        .summary-label Avg Bill
                        .summary-value#stat_avg_bill ₹0
                  .kt-form.kt-form--label-right.kt-margin-t-20.kt-margin-b-10
                    .row.align-items-end
                      .col-md-4
                        label Search
                        .kt-input-icon.kt-input-icon--left
                          input#generalSearch.form-control(type="text", placeholder="Search bill no / party / status...")
                          span.kt-input-icon__icon.kt-input-icon__icon--left
                            span
                              i.la.la-search

                      .col-md-2
                        label Store
                        select#filter_store.form-control
                          option(value="") All Stores

                      .col-md-2
                        label Status
                        select#filter_status.form-control
                          option(value="") All Status
                          option(value="DRAFT") DRAFT
                          option(value="FINAL") FINAL
                          option(value="CANCELLED") CANCELLED

                      .col-md-2
                        label From
                        input#filter_from.form-control(type="date")

                      .col-md-2
                        label To
                        input#filter_to.form-control(type="date")

                  .table-responsive
                    table#billsTable.table.table-striped.table-bordered.table-hover.table-checkable
                      thead
                        tr
                          th Date
                          th Store
                          th Party
                          th Bill No
                          th Status
                          th Qty
                          th Net Total
                          th Actions
                      tbody

          include ../partials/footer.pug

    // CREATE BILL MODAL
    #modalBillCreate.modal.fade(role="dialog" tabindex="-1" aria-hidden="true")
      .modal-dialog.modal-lg(role="document")
        .modal-content
          .modal-header
            h5.modal-title Create Bill
            button.close(type="button", data-dismiss="modal" aria-label="Close")
              span(aria-hidden="true") ×

          .modal-body
            form#billCreateForm
              .row
                .col-md-4
                  .form-group
                    label Store
                    select#bill_store.form-control(required)
                      option(value="" selected disabled) Select Store

                .col-md-4
                  .form-group
                    label Bill Date
                    input#bill_date.form-control(type="date" required)

                .col-md-4
                  .form-group
                    label Bill No
                    input#bill_no.form-control(type="text" placeholder="EW-0001")

              .form-group(style="position:relative")
                label Party
                input#partySearch.form-control(type="text", placeholder="Type party name / phone...", autocomplete="off")
                input#bill_partyId(type="hidden")
                small.text-muted Select party from suggestions.
                .dropdown-menu#partyDropdown(style="width:100%; display:none; max-height:220px; overflow:auto;")

              .form-group
                label Notes
                textarea#bill_notes.form-control(rows="2")

          .modal-footer
            button.btn.btn-secondary(type="button", data-dismiss="modal") Cancel
            button.btn.btn-brand(type="submit", form="billCreateForm") Create

    // BILL DETAIL MODAL
    #modalBillDetail.modal.fade(role="dialog" tabindex="-1" aria-hidden="true")
      .modal-dialog.modal-xl(role="document")
        .modal-content
          .modal-header
            h5.modal-title Bill Detail
            button.close(type="button", data-dismiss="modal" aria-label="Close")
              span(aria-hidden="true") ×

          .modal-body
            input#bill_id(type="hidden")

            .row
              .col-md-3
                .form-group
                  label Store
                  input#bill_store_view.form-control(readonly)

              .col-md-3
                .form-group
                  label Party
                  input#bill_party_view.form-control(readonly)

              .col-md-2
                .form-group
                  label Status
                  input#bill_status_view.form-control(readonly)

              .col-md-2
                .form-group
                  label Bill Date
                  input#bill_date_view.form-control(readonly)

              .col-md-2
                .form-group
                  label Bill No
                  input#bill_no_view.form-control(readonly)

            .row.mb-3
              .col-md-3
                .summary-card
                  .summary-label Qty Total
                  .summary-value#bill_qtyTotal 0

              .col-md-3
                .summary-card
                  .summary-label SubTotal
                  .summary-value#bill_subTotal ₹0

              .col-md-3
                .summary-card
                  .summary-label Discount
                  .summary-value#bill_discountTotal ₹0

              .col-md-3
                .summary-card
                  .summary-label Net Total
                  .summary-value#bill_netTotal ₹0

            hr

            .line-box
              .d-flex.justify-content-between.align-items-center.mb-3
                h5.mb-0 Add Line
                span.badge.badge-info#bill_hint_badge DRAFT editable only

              form#articleLineAddForm
                .row.align-items-end
                  .col-md-4
                    .form-group(style="position:relative")
                      label Article
                      input#articleSearch.form-control(type="text", placeholder="Type article / brand...", autocomplete="off")
                      input#articleIdHidden(type="hidden")
                      .dropdown-menu#articleDropdown(style="width:100%; display:none; max-height:260px; overflow:auto; position:absolute; top:72px; left:0; z-index:9999;")
                      small.text-muted Select from suggestions.

                  .col-md-2
                    .form-group
                      label Color
                      select#line_color.form-control(required disabled)
                        option(value="") Select Article First
                      small#color_avail_label.text-muted Available: -
                  .col-md-2
                    .form-group
                      label Batch
                      select#line_batch.form-control(required disabled)
                        option(value="") Select Color First
                      small#batch_avail_label.text-muted Batch stock: -
                  input#line_purchase_cost(type="hidden")
                  input#line_purchase_discount(type="hidden")
                  .col-md-1
                    .form-group
                      label Qty
                      input#line_qty.form-control(type="number", min="1", value="1", required)

                  .col-md-1
                    .form-group
                      label MRP
                      input#line_mrp.form-control(type="number", min="0", step="0.01", value="0", readonly)

                  .col-md-2
                    .form-group
                      label Rate
                      input#line_rate.form-control(type="number", min="0", step="0.01", required)
                  .col-md-1
                    .form-group
                      label Disc %
                      input#line_discount.form-control(type="number", min="0", max="100", step="0.01", value="0")

                  .col-md-1
                    .form-group
                      label &nbsp;
                      button.btn.btn-brand.btn-block(type="submit") Add

            .table-responsive
              table#billLinesTable.table.table-striped.table-bordered.table-hover
                thead
                  tr
                    th Article
                    th Brand
                    th Color
                    th Qty
                    th MRP
                    th Rate
                    th Disc %
                    th Amount
                    th Actions
                tbody

          .modal-footer
            button.btn.btn-outline-dark#btnPrintBill(type="button")
              i.la.la-print
              |  Print Bill
            button.btn.btn-secondary(type="button", data-dismiss="modal") Close
            button.btn.btn-outline-warning#btnReverseBill(type="button" style="display:none")
              i.la.la-undo
              |  Revert Final Bill
            button.btn.btn-warning#btnCancelBill(type="button") Cancel Bill
            button.btn.btn-success#btnFinalizeBill(type="button") Finalize Bill

    #kt_scrolltop.kt-scrolltop
      i.fa.fa-arrow-up

    script(src="/assets/plugins/global/plugins.bundle.js" type="text/javascript")
    script(src="/assets/js/scripts.bundle.js" type="text/javascript")
    script(src="/assets/plugins/custom/datatables/datatables.bundle.js" type="text/javascript")
    script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
    script(src="/rpanel/js/footwear/su/billing-ui.js" type="text/javascript")