doctype html
html(lang="en")
  include ../partials/head.pug
  body.kt-quick-panel--right.kt-demo-panel--right.kt-offcanvas-panel--right.kt-header--fixed.kt-header-mobile--fixed.kt-subheader--enabled.kt-subheader--fixed.kt-subheader--solid.kt-aside--enabled.kt-aside--fixed.kt-page--loading
    #kt_header_mobile.kt-header-mobile.kt-header-mobile--fixed
      .kt-header-mobile__logo
        a(href="index.html")
          img(alt="Logo" src="/assets/media/logos/logo-dark.png")
      .kt-header-mobile__toolbar
        button#kt_aside_mobile_toggler.kt-header-mobile__toggler.kt-header-mobile__toggler--left
          span
        button#kt_header_mobile_toggler.kt-header-mobile__toggler
          span
        button#kt_header_mobile_topbar_toggler.kt-header-mobile__topbar-toggler
          i.flaticon-more
    .kt-grid.kt-grid--hor.kt-grid--root
      .kt-grid__item.kt-grid__item--fluid.kt-grid.kt-grid--ver.kt-page
        include ../partials/sidenav.pug
        #kt_wrapper.kt-grid__item.kt-grid__item--fluid.kt-grid.kt-grid--hor.kt-wrapper
          include ../partials/topnav.pug
          #kt_content.kt-content.kt-grid__item.kt-grid__item--fluid.kt-grid.kt-grid--hor
            include ../partials/header.pug
            .kt-container.kt-container--fluid.kt-grid__item.kt-grid__item--fluid
              .kt-portlet.kt-portlet--mobile
                .kt-portlet__head
                  .kt-portlet__head-label
                    h3.kt-portlet__head-title Racks / Blocks
                  .kt-portlet__head-toolbar
                    a.btn.btn-secondary.btn-sm(href=`/su/footwear/stores/${storeId}/locations`)
                      i.la.la-arrow-left
                      |  Back
                    button.btn.btn-brand.btn-sm(type="button", data-toggle="modal", data-target="#modalRack")
                      i.la.la-plus
                      |  Add Rack
                .kt-portlet__body(style="padding-top:0")
                  // Header stats
                  .row.mt-3.mb-3
                    .col-md-12
                      .kt-portlet(style="border-radius:14px; border:1px solid #eef1f5; box-shadow:0 8px 18px rgba(0,0,0,.03);")
                        .kt-portlet__body(style="padding:14px 16px;")
                          .d-flex.justify-content-between.align-items-center.flex-wrap
                            .d-flex.align-items-center
                              i.la.la-th-large.kt-font-brand(style="font-size:30px; margin-right:12px;")
                              div
                                div(style="font-weight:900; font-size:16px; line-height:1.2;") Racks / Blocks
                                div.text-muted(style="font-size:12px;") Visual overview of capacity, usage & quick actions
                            .d-flex.align-items-center.mt-2.mt-md-0
                              input#rackSearch.form-control.form-control-sm(type="text" placeholder="Search rack code / name / category..." style="min-width:260px; margin-right:8px;")
                              button.btn.btn-sm.btn-outline-brand(type="button" data-toggle="modal" data-target="#modalRack")
                                i.la.la-plus
                                | Add Rack

                  // Summary numbers
                  .row.mb-3
                    .col-md-3
                      .alert.alert-light(style="padding:10px; border-radius:12px;")
                        div.text-muted(style="font-size:12px;") Total Racks
                        div#statRacks(style="font-weight:900; font-size:18px;") 0
                    .col-md-3
                      .alert.alert-light(style="padding:10px; border-radius:12px;")
                        div.text-muted(style="font-size:12px;") Total Capacity
                        div#statCap(style="font-weight:900; font-size:18px;") -
                    .col-md-3
                      .alert.alert-light(style="padding:10px; border-radius:12px;")
                        div.text-muted(style="font-size:12px;") Used
                        div#statUsed(style="font-weight:900; font-size:18px;") 0
                    .col-md-3
                      .alert.alert-light(style="padding:10px; border-radius:12px;")
                        div.text-muted(style="font-size:12px;") Free
                        div#statFree(style="font-weight:900; font-size:18px;") -

                  // Cards grid
                  #racksGrid.row
                    // cards will be injected here by JS

                  // Fallback empty
                  #racksEmpty.alert.alert-light(style="display:none; border-radius:12px;")
                    b No racks found.
                    |  Create your first rack/block using “Add Rack”.

          include ../partials/footer.pug
    // CREATE/EDIT RACK MODAL
    #modalRack.modal.fade(role="dialog" tabindex="-1")
      .modal-dialog.modal-md(role="document")
        .modal-content
          .modal-header
            h5.modal-title Rack / Block
            button.close(type="button", data-dismiss="modal" aria-label="Close")
              span(aria-hidden="true") ×
          .modal-body
            form#rackForm
              input#rack_id(type="hidden")
              .row
                .col-md-6
                  .form-group
                    label Rack Code *
                    input#rack_code.form-control(type="text" placeholder="A1 / B2" required)
                .col-md-6
                  .form-group
                    label Rack Name *
                    input#rack_name.form-control(type="text" placeholder="RACK A1" required)
              .row
                .col-md-6
                  .form-group
                    label Category Group *
                    select#rack_group.form-control(required)
                      option(value="MEN") MEN
                      option(value="WOMEN") WOMEN
                      option(value="KIDS") KIDS
                      option(value="UNISEX") UNISEX
                .col-md-6
                    .form-group
                    label Category *
                    select#rack_category.form-control(required)
                        option(value="") Select category...
              .row
                .col-md-6
                  .form-group
                    label Capacity (Pairs)
                    input#rack_capacity.form-control(type="number" min="0" placeholder="0 = unlimited")
              .form-group
                label Active
                select#rack_active.form-control
                  option(value="true" selected) Yes
                  option(value="false") No
          .modal-footer
            button.btn.btn-secondary(type="button", data-dismiss="modal") Cancel
            button.btn.btn-brand(type="submit", form="rackForm") Save
    #kt_scrolltop.kt-scrolltop
      i.fa.fa-arrow-up
    script(src="/assets/plugins/global/plugins.bundle.js" type="text/javascript")
    script(src="/assets/js/scripts.bundle.js" type="text/javascript")
    script(src="/assets/plugins/custom/datatables/datatables.bundle.js" type="text/javascript")
    script.
      window.__STORE_ID__ = "#{storeId}";
      window.__LOCATION_ID__ = "#{locationId}";
    script(src="/rpanel/js/footwear/su/location-racks-ui.js" type="text/javascript")