doctype html
html(lang="en")
  include ../partials/head.pug

  body.kt-quick-panel--right.kt-demo-panel--right.kt-offcanvas-panel--right.kt-header--fixed.kt-header-mobile--fixed.kt-subheader--enabled.kt-subheader--fixed.kt-subheader--solid.kt-aside--enabled.kt-aside--fixed.kt-page--loading
    .kt-grid.kt-grid--hor.kt-grid--root
      .kt-grid__item.kt-grid__item--fluid.kt-grid.kt-grid--ver.kt-page
        include ../partials/sidenav.pug

        #kt_wrapper.kt-grid__item.kt-grid__item--fluid.kt-grid.kt-grid--hor.kt-wrapper
          include ../partials/topnav.pug

          #kt_content.kt-content.kt-grid__item.kt-grid__item--fluid.kt-grid.kt-grid--hor
            include ../partials/header.pug

            .kt-container.kt-container--fluid.kt-grid__item.kt-grid__item--fluid
              .kt-portlet.kt-portlet--mobile
                .kt-portlet__head
                  .kt-portlet__head-label
                    h3.kt-portlet__head-title
                      span#rackTitle Rack
                      small.text-muted(style="font-size:12px; margin-left:8px;") Items & Allocation
                  .kt-portlet__head-toolbar
                    a.btn.btn-secondary.btn-sm(href="javascript:history.back()")
                      i.la.la-arrow-left
                      | Back
                    button.btn.btn-brand.btn-sm(type="button", data-toggle="modal", data-target="#modalAddSku")
                      i.la.la-plus
                      | Add SKU

                .kt-portlet__body(style="padding-top:12px;")
                  // ✅ RACK HEADER CARD (context + capacity bar)
                  .kt-portlet(style="border-radius:16px; border:1px solid #eef1f5; box-shadow:0 10px 24px rgba(0,0,0,.04); margin-bottom:16px;")
                    .kt-portlet__body(style="padding:16px 18px;")
                      .d-flex.justify-content-between.align-items-start.flex-wrap
                        .d-flex.align-items-start
                          i.la.la-cubes.kt-font-brand(style="font-size:34px; margin-right:14px;")
                          div
                            div#rackHeaderText(style="font-weight:900; font-size:18px; line-height:1.2;") -
                            div#rackSubText.text-muted(style="font-size:13px; margin-top:2px;") -
                        .text-right
                          span.badge.badge-light(style="font-size:12px; padding:6px 10px;")
                            | Capacity:
                            b &nbsp;
                            span#rackCapText -
                      .mt-3
                        .d-flex.justify-content-between(style="font-size:13px;")
                          span
                            b#rackUsedText 0 Pairs
                            |  used
                          span
                            b#rackFreeText 0 Pairs
                            |  free
                        .progress(style="height:12px; border-radius:999px; margin-top:6px;")
                          .progress-bar#rackCapBar(role="progressbar" style="width:0%; border-radius:999px;")

                  // ✅ Table (compact: SKU cell + Size + Qty)
                  table#rackItemsTable.table.table-striped.table-bordered.table-hover.table-checkable(style="border-radius:14px; overflow:hidden;")
                    thead
                      tr
                        th SKU
                        th.text-center Size
                        th.text-center Qty
                        th.text-center Actions
                    tbody

          include ../partials/footer.pug

    // ADD/UPDATE SKU QTY MODAL
    #modalAddSku.modal.fade(role="dialog" tabindex="-1")
      .modal-dialog.modal-md(role="document")
        .modal-content(style="border-radius:16px; overflow:hidden;")
          .modal-header
            h5.modal-title Add / Update SKU Qty
            button.close(type="button", data-dismiss="modal" aria-label="Close")
              span(aria-hidden="true") ×
          .modal-body
            form#rackItemForm
              input#rs_id(type="hidden")

              // populated via JS
              input#rack_group(type="hidden")
              input#rack_category(type="hidden")
              input#rack_capacity(type="hidden")

              .alert.alert-light(style="padding:10px; border-radius:12px;")
                strong Rack:
                span#rackMetaText(style="margin-left:8px;") -

              .form-group(style="position:relative;")
                label SKU Code
                input#skuSearch.form-control(
                  type="text"
                  autocomplete="off"
                  placeholder="Search SKU (code / article / brand)..."
                )
                #skuSuggest.dropdown-menu(style="width:100%; max-height:280px; overflow:auto; display:none; z-index:99999; border-radius:12px;")

              .row
                .col-md-6
                  .form-group
                    label Free to Assign
                    input#rs_availableQty.form-control(type="text" readonly value="0")
                .col-md-6
                  .form-group
                    label Existing in this Rack
                    input#rs_totalQty.form-control(type="text" readonly value="0")

              .form-group
                label Qty to Set *
                input#rs_qty.form-control(type="number" min="0" value="0" required)

              small.text-muted#capHint

          .modal-footer
            button.btn.btn-secondary(type="button", data-dismiss="modal") Cancel
            button.btn.btn-brand(type="submit", form="rackItemForm") Save

    script(src="/assets/plugins/global/plugins.bundle.js" type="text/javascript")
    script(src="/assets/js/scripts.bundle.js" type="text/javascript")
    script(src="/assets/plugins/custom/datatables/datatables.bundle.js" type="text/javascript")

    script.
      window.__RACK_ID__ = "#{rackId}";
      window.__STORE_ID__ = "#{storeId || ''}";
    script(src="/rpanel/js/footwear/su/rack-items-ui.js" type="text/javascript")
