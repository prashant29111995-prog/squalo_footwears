doctype html
html(lang="en")
  include ../partials/head.pug

  style.
    .report-page-head{
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      gap:12px;
      margin-bottom:18px;
    }
    .report-title h3{
      margin:0;
      font-weight:900;
      color:#2c2e3e;
    }
    .report-title small{
      color:#8a90a5;
      font-size:13px;
    }
    .report-actions{
      display:flex;
      gap:8px;
      flex-wrap:wrap;
    }
    .report-card{
      border:1px solid #edf0f7;
      border-radius:14px;
      background:#fff;
      padding:16px;
      margin-bottom:16px;
      box-shadow:0 8px 24px rgba(31,45,61,.04);
    }
    .metric-card{
      border:1px solid #edf0f7;
      border-radius:14px;
      background:#fbfcff;
      padding:16px;
      min-height:106px;
      position:relative;
      overflow:hidden;
    }
    .metric-card:after{
      content:"";
      position:absolute;
      right:-24px;
      top:-24px;
      width:78px;
      height:78px;
      border-radius:50%;
      background:rgba(93,120,255,.07);
    }
    .metric-label{
      font-size:11px;
      color:#74788d;
      text-transform:uppercase;
      font-weight:800;
      letter-spacing:.4px;
      margin-bottom:9px;
    }
    .metric-value{
      font-size:24px;
      font-weight:900;
      color:#2c2e3e;
      line-height:1.1;
    }
    .metric-help{
      font-size:11px;
      color:#8a90a5;
      margin-top:6px;
    }
    .metric-blue .metric-value{color:#5d78ff}
    .metric-green .metric-value{color:#10b981}
    .metric-red .metric-value{color:#ef4444}
    .metric-orange .metric-value{color:#f59e0b}
    .filter-box{
      border:1px solid #edf0f7;
      border-radius:14px;
      background:#f9fafc;
      padding:14px;
      margin-bottom:16px;
    }
    .nav-tabs .nav-link{
      font-weight:800;
    }
    .table th{
      background:#f8f9fb;
      font-weight:900!important;
      white-space:nowrap;
    }
    .table td{
      vertical-align:middle!important;
      white-space:nowrap;
    }
    .amount-profit{color:#10b981;font-weight:900}
    .amount-loss{color:#ef4444;font-weight:900}
    .risk-chip{
      display:inline-flex;
      align-items:center;
      padding:5px 10px;
      border-radius:999px;
      font-size:11px;
      font-weight:800;
    }
    .risk-low{background:#e8fff3;color:#10b981}
    .risk-medium{background:#fff4de;color:#f59e0b}
    .risk-high{background:#ffe2e5;color:#ef4444}
    .report-section-title{
      font-size:16px;
      font-weight:900;
      color:#2c2e3e;
      margin-bottom:12px;
    }
    .insight-box{
      border:1px dashed #cfd5e6;
      background:#fbfcff;
      border-radius:14px;
      padding:14px;
    }
    .insight-box ul{
      margin:0;
      padding-left:18px;
      color:#4b5563;
    }
    .insight-box li{
      margin-bottom:8px;
    }

  body.kt-quick-panel--right.kt-demo-panel--right.kt-offcanvas-panel--right.kt-header--fixed.kt-header-mobile--fixed.kt-subheader--enabled.kt-subheader--fixed.kt-subheader--solid.kt-aside--enabled.kt-aside--fixed.kt-page--loading
    #kt_header_mobile.kt-header-mobile.kt-header-mobile--fixed
      .kt-header-mobile__logo
        a(href="index.html")
          img(alt="Logo" src="/assets/media/logos/logo-dark.png")
      .kt-header-mobile__toolbar
        button#kt_aside_mobile_toggler.kt-header-mobile__toggler.kt-header-mobile__toggler--left
          span
        button#kt_header_mobile_toggler.kt-header-mobile__toggler
          span
        button#kt_header_mobile_topbar_toggler.kt-header-mobile__topbar-toggler
          i.flaticon-more

    .kt-grid.kt-grid--hor.kt-grid--root
      .kt-grid__item.kt-grid__item--fluid.kt-grid.kt-grid--ver.kt-page
        include ../partials/sidenav.pug

        #kt_wrapper.kt-grid__item.kt-grid__item--fluid.kt-grid.kt-grid--hor.kt-wrapper
          include ../partials/topnav.pug

          #kt_content.kt-content.kt-grid__item.kt-grid__item--fluid.kt-grid.kt-grid--hor
            include ../partials/header.pug

            .kt-container.kt-container--fluid.kt-grid__item.kt-grid__item--fluid

              .report-page-head
                .report-title
                  h3 Business Reports
                  small Sales, profit, stock, party risk and catalogue analytics
                .report-actions
                  button#btnRefreshReports.btn.btn-outline-brand.btn-sm(type="button")
                    i.la.la-refresh
                    |  Refresh

                  button#btnPrintReports.btn.btn-outline-dark.btn-sm(type="button")
                    i.la.la-print
                    |  Print Outstanding

                  button#btnExportExtDis.btn.btn-outline-success.btn-sm(type="button")
                    i.la.la-file-excel-o
                    |  Export EXT-DIS

                  button#btnExportReports.btn.btn-brand.btn-sm(type="button")
                    i.la.la-download
                    |  Export JSON
              // FILTERS
              .report-card
                .report-section-title Filters
                .filter-box
                  .row.align-items-end
                    .col-md-2
                      label Store
                      select#filterStore.form-control
                        option(value="") All Stores

                    .col-md-2
                      label Category Group
                      select#filterCategoryGroup.form-control
                        option(value="") All Groups
                        option(value="MEN") MEN
                        option(value="WOMEN") WOMEN
                        option(value="KIDS") KIDS
                        option(value="UNISEX") UNISEX

                    .col-md-2
                      label Category
                      select#filterCategory.form-control
                        option(value="") All Categories

                    .col-md-2
                      label From
                      input#filterFrom.form-control(type="date")

                    .col-md-2
                      label To
                      input#filterTo.form-control(type="date")

                    .col-md-2
                      label Period
                      select#filterPeriod.form-control
                        option(value="today") Today
                        option(value="7days") Last 7 Days
                        option(value="30days") Last 30 Days
                        option(value="month" selected) This Month
                        option(value="custom") Custom

                  .row.mt-3.align-items-end
                    .col-md-4
                      label Search
                      .kt-input-icon.kt-input-icon--left
                        input#generalSearch.form-control(type="text", placeholder="Search brand / article / party...")
                        span.kt-input-icon__icon.kt-input-icon__icon--left
                          span
                            i.la.la-search

                    .col-md-2
                      button#btnApplyFilters.btn.btn-brand.btn-block(type="button")
                        i.la.la-filter
                        |  Apply

                    .col-md-2
                      button#btnResetFilters.btn.btn-outline-secondary.btn-block(type="button")
                        i.la.la-undo
                        |  Reset

              // DAILY SNAPSHOT
              .row.mb-3
                .col-md-2
                  .metric-card.metric-blue
                    .metric-label Today Sales
                    .metric-value#stat_today_sales ₹0
                    .metric-help Final bills today

                .col-md-2
                  .metric-card.metric-green
                    .metric-label Today Collection
                    .metric-value#stat_today_collection ₹0
                    .metric-help Payments received

                .col-md-2
                  .metric-card.metric-orange
                    .metric-label Today Profit
                    .metric-value#stat_today_profit ₹0
                    .metric-help Estimated gross profit

                .col-md-2
                  .metric-card
                    .metric-label Qty Sold
                    .metric-value#stat_today_qty 0
                    .metric-help Pairs sold today

                .col-md-2
                  .metric-card.metric-red
                    .metric-label Outstanding
                    .metric-value#stat_total_outstanding ₹0
                    .metric-help Party receivables

                .col-md-2
                  .metric-card
                    .metric-label Active Parties
                    .metric-value#stat_active_parties 0
                    .metric-help Customers/suppliers

              // INVENTORY HEALTH
              .row.mb-3
                .col-md-3
                  .metric-card.metric-blue
                    .metric-label Total Stock Qty
                    .metric-value#stat_stock_qty 0
                    .metric-help Available inventory

                .col-md-3
                  .metric-card.metric-orange
                    .metric-label Stock Value
                    .metric-value#stat_stock_value ₹0
                    .metric-help Cost based valuation

                .col-md-3
                  .metric-card.metric-red
                    .metric-label Dead Stock Value
                    .metric-value#stat_dead_stock_value ₹0
                    .metric-help Unsold slow stock

                .col-md-3
                  .metric-card.metric-green
                    .metric-label Catalogue Ready
                    .metric-value#stat_catalogue_ready 0%
                    .metric-help Products with images

              // INSIGHTS
              .row
                .col-md-8
                  .report-card
                    .report-section-title Daily Business Questions
                    .insight-box
                      ul
                        li#insight_fast_product Which article is selling fastest?
                        li#insight_dead_stock Which stock is blocking money?
                        li#insight_party_risk Which party needs payment follow-up?
                        li#insight_margin Which brand/article gives best margin?
                        li#insight_reorder Which item should be reordered?

                .col-md-4
                  .report-card
                    .report-section-title AI Suggestions
                    .insight-box
                      ul
                        li#ai_suggestion_1 Load report data to generate suggestions.
                        li#ai_suggestion_2 Slow stock and party risk will appear here.
                        li#ai_suggestion_3 Reorder alerts will appear here.

              // TABS
              .report-card
                ul.nav.nav-tabs(role="tablist")
                  li.nav-item
                    a.nav-link.active(data-toggle="tab", href="#tabTopProducts", role="tab") Top Products
                  li.nav-item
                    a.nav-link(data-toggle="tab", href="#tabDeadStock", role="tab") Dead Stock
                  li.nav-item
                    a.nav-link(data-toggle="tab", href="#tabBrandAnalysis", role="tab") Brand Analysis
                  li.nav-item
                    a.nav-link(data-toggle="tab", href="#tabPartyRisk", role="tab") Party Risk
                  li.nav-item
                    a.nav-link(data-toggle="tab", href="#tabCollections", role="tab") Collections
                  li.nav-item
                    a.nav-link(data-toggle="tab", href="#tabProfit", role="tab") Profit
                  li.nav-item
                    a.nav-link(data-toggle="tab", href="#tabCatalogue", role="tab") Catalogue

                .tab-content.mt-4

                  // TOP PRODUCTS
                  #tabTopProducts.tab-pane.active(role="tabpanel")
                    .table-responsive
                      table#topProductsTable.table.table-bordered.table-hover
                        thead
                          tr
                            th Rank
                            th Brand
                            th Article
                            th Color
                            th Category
                            th Qty Sold
                            th Sales
                            th Profit
                            th Margin %
                            th Action
                        tbody
                          tr
                            td.text-center.text-muted(colspan="10") Loading...

                  // DEAD STOCK
                  #tabDeadStock.tab-pane(role="tabpanel")
                    .table-responsive
                      table#deadStockTable.table.table-bordered.table-hover
                        thead
                          tr
                            th Brand
                            th Article
                            th Color
                            th Category
                            th Stock Qty
                            th Stock Value
                            th Last Sale
                            th Days Unsold
                            th Risk
                            th Action
                        tbody
                          tr
                            td.text-center.text-muted(colspan="10") Loading...

                  // BRAND ANALYSIS
                  #tabBrandAnalysis.tab-pane(role="tabpanel")
                    .table-responsive
                      table#brandAnalysisTable.table.table-bordered.table-hover
                        thead
                          tr
                            th Brand
                            th Sales
                            th Profit
                            th Margin %
                            th Stock Qty
                            th Stock Value
                            th Dead Stock
                            th Performance
                        tbody
                          tr
                            td.text-center.text-muted(colspan="8") Loading...

                  // PARTY RISK
                  #tabPartyRisk.tab-pane(role="tabpanel")
                    .table-responsive
                      table#partyRiskTable.table.table-bordered.table-hover
                        thead
                          tr
                            th Party
                            th Phone
                            th Outstanding
                            th Total Business
                            th Last Sale
                            th Last Payment
                            th Risk
                            th Action
                        tbody
                          tr
                            td.text-center.text-muted(colspan="8") Loading...

                  // COLLECTIONS
                  #tabCollections.tab-pane(role="tabpanel")
                    .table-responsive
                      table#collectionsTable.table.table-bordered.table-hover
                        thead
                          tr
                            th Party
                            th Pending
                            th Last Bill
                            th Last Payment
                            th Days Pending
                            th Suggested Follow-up
                            th Action
                        tbody
                          tr
                            td.text-center.text-muted(colspan="7") Loading...

                  // PROFIT
                  #tabProfit.tab-pane(role="tabpanel")
                    .table-responsive
                      table#profitTable.table.table-bordered.table-hover
                        thead
                          tr
                            th Brand
                            th Article
                            th Color
                            th MRP
                            th Avg Cost
                            th Avg Sale Rate
                            th Profit / Pair
                            th Margin %
                            th Sold Qty
                        tbody
                          tr
                            td.text-center.text-muted(colspan="9") Loading...

                  // CATALOGUE
                  #tabCatalogue.tab-pane(role="tabpanel")
                    .row.mb-3
                      .col-md-3
                        .metric-card.metric-green
                          .metric-label Products With Images
                          .metric-value#cat_with_images 0
                          .metric-help Catalogue ready

                      .col-md-3
                        .metric-card.metric-red
                          .metric-label Missing Images
                          .metric-value#cat_missing_images 0
                          .metric-help Need upload

                      .col-md-3
                        .metric-card.metric-blue
                          .metric-label Export Ready
                          .metric-value#cat_export_ready 0
                          .metric-help WhatsApp/social ready

                      .col-md-3
                        .metric-card.metric-orange
                          .metric-label Image Coverage
                          .metric-value#cat_image_coverage 0%
                          .metric-help Completion %

                    .table-responsive
                      table#catalogueTable.table.table-bordered.table-hover
                        thead
                          tr
                            th Brand
                            th Article
                            th Color
                            th Stock Qty
                            th Image Status
                            th Catalogue Status
                            th Action
                        tbody
                          tr
                            td.text-center.text-muted(colspan="7") Loading...

          include ../partials/footer.pug

    #kt_scrolltop.kt-scrolltop
      i.fa.fa-arrow-up

    script.
      var KTAppOptions = {
        "colors": {
          "state": {
            "brand": "#5d78ff",
            "dark": "#282a3c",
            "light": "#ffffff",
            "primary": "#5867dd",
            "success": "#34bfa3",
            "info": "#36a3f7",
            "warning": "#ffb822",
            "danger": "#fd3995"
          },
          "base": {
            "label": ["#c5cbe3", "#a1a8c3", "#3d4465", "#3e4466"],
            "shape": ["#f0f3ff", "#d9dffa", "#afb4d4", "#646c9a"]
          }
        }
      };

    script(src="/assets/plugins/global/plugins.bundle.js" type="text/javascript")
    script(src="/assets/js/scripts.bundle.js" type="text/javascript")
    script(src="/assets/plugins/custom/datatables/datatables.bundle.js" type="text/javascript")
    script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
    script(src="/rpanel/js/footwear/su/reports-ui.js" type="text/javascript")