doctype html
html(lang="en")
  include ../partials/head.pug

  link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css")

  style.
    .stock-page .kt-portlet__body {
      padding-top: 15px;
    }

    .stock-card {
      border: 1px solid #eef1f5;
      border-radius: 8px;
      background: #fff;
      padding: 16px;
      margin-bottom: 16px;
    }

    .stock-card-title {
      font-weight: 600;
      font-size: 15px;
      margin-bottom: 12px;
      color: #2c2e3e;
    }

    .summary-box {
      border: 1px solid #edf0f7;
      border-radius: 8px;
      padding: 12px;
      background: #f9fafc;
      min-height: 76px;
    }

    .summary-label {
      font-size: 12px;
      color: #74788d;
      margin-bottom: 4px;
    }

    .summary-value {
      font-size: 20px;
      font-weight: 700;
      color: #2c2e3e;
    }

    .line-form-box {
      border: 1px dashed #cfd5e6;
      border-radius: 8px;
      padding: 14px;
      background: #fbfcff;
      margin-bottom: 16px;
    }

    .table td,
    .table th {
      vertical-align: middle !important;
    }

    .action-btns .btn {
      margin-right: 4px;
    }

    .readonly-input {
      background: #f7f8fa !important;
      cursor: not-allowed;
    }

    .bill-status-chip {
      font-size: 12px;
      padding: 5px 10px;
      border-radius: 20px;
      font-weight: 600;
    }

    .bill-status-draft {
      background: #fff4de;
      color: #ff8a00;
    }

    .bill-status-confirmed {
      background: #e8fff3;
      color: #1dc9b7;
    }

    .bill-status-cancelled {
      background: #ffe2e5;
      color: #f64e60;
    }

    .select2-container--default .select2-selection--single {
      height: 38px;
      border: 1px solid #e2e5ec;
    }

    .select2-container--default .select2-selection--single .select2-selection__rendered {
      line-height: 36px;
    }

    .select2-container--default .select2-selection--single .select2-selection__arrow {
      height: 36px;
    }

  body.kt-quick-panel--right.kt-demo-panel--right.kt-offcanvas-panel--right.kt-header--fixed.kt-header-mobile--fixed.kt-subheader--enabled.kt-subheader--fixed.kt-subheader--solid.kt-aside--enabled.kt-aside--fixed.kt-page--loading

    // begin:: Header Mobile
    #kt_header_mobile.kt-header-mobile.kt-header-mobile--fixed
      .kt-header-mobile__logo
        a(href="index.html")
          img(alt="Logo" src="/assets/media/logos/logo-dark.png")
      .kt-header-mobile__toolbar
        button#kt_aside_mobile_toggler.kt-header-mobile__toggler.kt-header-mobile__toggler--left
          span
        button#kt_header_mobile_toggler.kt-header-mobile__toggler
          span
        button#kt_header_mobile_topbar_toggler.kt-header-mobile__topbar-toggler
          i.flaticon-more
    // end:: Header Mobile

    .kt-grid.kt-grid--hor.kt-grid--root
      .kt-grid__item.kt-grid__item--fluid.kt-grid.kt-grid--ver.kt-page
        include ../partials/sidenav.pug

        #kt_wrapper.kt-grid__item.kt-grid__item--fluid.kt-grid.kt-grid--hor.kt-wrapper
          include ../partials/topnav.pug

          #kt_content.kt-content.kt-grid__item.kt-grid__item--fluid.kt-grid.kt-grid--hor.stock-page
            include ../partials/header.pug

            .kt-container.kt-container--fluid.kt-grid__item.kt-grid__item--fluid

              // PAGE HEADER
              .kt-portlet.kt-portlet--mobile
                .kt-portlet__head
                  .kt-portlet__head-label
                    h3.kt-portlet__head-title
                      | Stock-In / Purchase Intake
                      small.ml-2 Article → Color → Quantity
                  .kt-portlet__head-toolbar
                    button.btn.btn-brand.btn-sm(type="button", data-toggle="modal", data-target="#modalBillCreate")
                      i.la.la-plus
                      |  Create New Bill

                .kt-portlet__body
                  // MONTH SUMMARY
                  .row.mb-4
                    .col-md-3
                      .summary-box
                        .summary-label Current Month Purchase
                        .summary-value#stat_month_amount ₹0

                    .col-md-3
                      .summary-box
                        .summary-label Total Qty
                        .summary-value#stat_month_qty 0

                    .col-md-2
                      .summary-box
                        .summary-label Bills
                        .summary-value#stat_month_bills 0

                    .col-md-2
                      .summary-box
                        .summary-label Confirmed
                        .summary-value#stat_confirmed_bills 0

                    .col-md-2
                      .summary-box
                        .summary-label Draft
                        .summary-value#stat_draft_bills 0
                  // FILTERS
                  .stock-card
                    .stock-card-title Search & Filters
                    .row.align-items-end
                      .col-md-3.col-sm-12
                        .form-group
                          label Search
                          .kt-input-icon.kt-input-icon--left
                            input#generalSearch.form-control(type="text", placeholder="Search bill no / supplier...")
                            span.kt-input-icon__icon.kt-input-icon__icon--left
                              span
                                i.la.la-search

                      .col-md-2.col-sm-6
                        .form-group
                          label Status
                          select#statusFilter.form-control
                            option(value="") All Status
                            option(value="DRAFT") Draft
                            option(value="CONFIRMED") Confirmed
                            option(value="CANCELLED") Cancelled

                      .col-md-2.col-sm-6
                        .form-group
                          label From Date
                          input#fromDate.form-control(type="date")

                      .col-md-2.col-sm-6
                        .form-group
                          label To Date
                          input#toDate.form-control(type="date")

                      .col-md-3.col-sm-6
                        .form-group
                          label &nbsp;
                          button#resetFilters.btn.btn-outline-secondary.btn-block(type="button")
                            i.la.la-refresh
                            |  Reset Filters

                  // BILL LIST
                  .stock-card
                    .d-flex.justify-content-between.align-items-center.mb-3
                      .stock-card-title.mb-0 Stock-In Bills
                      small.text-muted Use Lines button to open bill lines

                    .table-responsive
                      table#stockInTable.table.table-striped.table-bordered.table-hover.table-checkable
                        thead
                          tr
                            th Bill Date
                            th Bill No
                            th Supplier
                            th Status
                            th Total Qty
                            th Total Lines
                            th Amount
                            th Bill File
                            th Actions
                        tbody

          include ../partials/footer.pug

    // CREATE BILL MODAL
    #modalBillCreate.modal.fade(role="dialog" tabindex="-1")
      .modal-dialog.modal-lg(role="document")
        .modal-content
          .modal-header
            h5.modal-title Create Stock-In Bill
            button.close(type="button", data-dismiss="modal", aria-label="Close")
              span(aria-hidden="true") ×

          .modal-body
            form#billCreateForm
              .row
                .col-md-6
                  .form-group
                    label.font-weight-bold Supplier
                    select#bill_supplierId.form-control(required)
                      option(value="") Select Supplier

                .col-md-6
                  .form-group
                    label.font-weight-bold Bill No
                    input#bill_billNo.form-control(type="text", placeholder="Supplier bill number", required)

              .row
                .col-md-6
                  .form-group
                    label.font-weight-bold Bill Date
                    input#bill_billDate.form-control(type="date", required)

                .col-md-6
                  .form-group
                    label.font-weight-bold Store / Location
                    select#bill_storeId.form-control(required)
                      option(value="") Select Store

              .form-group
                label Upload Supplier Bill
                input#bill_attachment_file.form-control(type="file", accept="application/pdf,image/*")
                input#bill_attachment(type="hidden")
                small#bill_attachment_status.text-muted No file uploaded

          .modal-footer
            button.btn.btn-secondary(type="button", data-dismiss="modal") Cancel
            button.btn.btn-brand(type="submit", form="billCreateForm")
              i.la.la-save
              |  Save Draft

    // EDIT BILL MODAL
    #modalBillEdit.modal.fade(role="dialog" tabindex="-1")
      .modal-dialog.modal-lg(role="document")
        .modal-content
          .modal-header
            h5.modal-title Update Draft Bill
            button.close(type="button", data-dismiss="modal", aria-label="Close")
              span(aria-hidden="true") ×

          .modal-body
            form#billEditForm
              input#edit_bill_id(type="hidden")

              .row
                .col-md-6
                  .form-group
                    label.font-weight-bold Supplier
                    select#edit_bill_supplierId.form-control(required)
                      option(value="") Select Supplier

                .col-md-6
                  .form-group
                    label.font-weight-bold Bill No
                    input#edit_bill_billNo.form-control(type="text", required)

              .row
                .col-md-6
                  .form-group
                    label.font-weight-bold Bill Date
                    input#edit_bill_billDate.form-control(type="date", required)

                .col-md-6
                  .form-group
                    label.font-weight-bold Store / Location
                    select#edit_bill_storeId.form-control(required)
                      option(value="") Select Store

              .form-group
                label Upload Supplier Bill
                input#edit_bill_attachment_file.form-control(type="file", accept="application/pdf,image/*")
                input#edit_bill_attachment(type="hidden")
                small#edit_bill_attachment_status.text-muted No file uploaded

          .modal-footer
            button.btn.btn-secondary(type="button", data-dismiss="modal") Cancel
            button.btn.btn-brand(type="submit", form="billEditForm")
              i.la.la-save
              |  Update Draft

    // BILL LINES MODAL
    #modalBillLines.modal.fade(role="dialog" tabindex="-1")
      .modal-dialog.modal-xl(role="document")
        .modal-content
          .modal-header
            div
              h5.modal-title.mb-1
                | Stock-In Bill: 
                span#lines_bill_title
              small.text-muted Add stock by Article + Color only. No size tracking.
            button.close(type="button", data-dismiss="modal", aria-label="Close")
              span(aria-hidden="true") ×

          .modal-body
            input#lines_bill_id(type="hidden")
            input#lines_bill_status(type="hidden")

            // BILL SUMMARY
            .row.mb-3
              .col-md-3
                .summary-box
                  .summary-label Status
                  .summary-value
                    span#summary_status.bill-status-chip.bill-status-draft DRAFT

              .col-md-3
                .summary-box
                  .summary-label Total Quantity
                  .summary-value#summary_total_qty 0

              .col-md-3
                .summary-box
                  .summary-label Total Lines
                  .summary-value#summary_total_lines 0

              .col-md-3
                .summary-box
                  .summary-label Bill Amount
                  .summary-value#summary_total_amount ₹0

            // QUICK LINE FORM
            .line-form-box
              .d-flex.justify-content-between.align-items-center.mb-2
                h6.mb-0 Add / Edit Stock Line
                button#btnQuickAddArticle.btn.btn-outline-brand.btn-sm(type="button")
                  i.la.la-plus
                  |  New Article
                button#btnScanBill.btn.btn-outline-success.btn-sm(type="button")
                  i.la.la-camera
                  |  Scan Bill
                input#billScanFile(type="file", accept="application/pdf,image/*", style="display:none")
              form#lineForm
                input#line_bill_id(type="hidden")
                input#line_id(type="hidden")

                .row.align-items-end
                  .col-md-4
                    .form-group
                      label.font-weight-bold Article
                      select#line_articleId.form-control(required)
                        option(value="") Search Article

                  .col-md-2
                    .form-group
                      label.font-weight-bold Brand
                      input#line_brand.form-control.readonly-input(type="text", readonly, required)

                  .col-md-3
                    .form-group
                      label.font-weight-bold Article Name
                      input#line_articleName.form-control.readonly-input(type="text", readonly, required)

                  .col-md-3
                    .form-group
                      label.font-weight-bold Color
                      select#line_color_select.form-control(disabled)
                        option(value="") Select Article First
                        option(value="__ADD_NEW__") + Add New Color

                      input#line_color.form-control.mt-2(
                        type="text",
                        placeholder="Enter new color",
                        style="display:none"
                      )
                      small#color_help.text-muted Select existing color or add new.

                .row.align-items-end
                  .col-md-2
                    .form-group
                      label.font-weight-bold Qty
                      input#line_qty.form-control(type="number", min="1", step="1", placeholder="Pairs", required)

                  .col-md-2
                    .form-group
                      label.font-weight-bold Cost
                      input#line_cost.form-control.readonly-input(type="number", readonly)

                  .col-md-2
                    .form-group
                      label.font-weight-bold Amount
                      input#line_amount.form-control.readonly-input(type="number", readonly)
                  .col-md-2
                    .form-group
                      label.font-weight-bold MRP
                      input#line_mrp.form-control(type="number", min="0", step="0.01", placeholder="MRP", required)

                  .col-md-2
                    .form-group
                      label.font-weight-bold Discount %
                      input#line_discountPercent.form-control(type="number", min="0", max="100", step="0.01", placeholder="Disc %", required)
                  .col-md-4
                    .form-group
                      label Remarks
                      input#line_remarks.form-control(type="text", placeholder="Optional")

                  .col-md-2
                    .form-group
                      label &nbsp;
                      button#lineSaveBtn.btn.btn-brand.btn-block(type="submit")
                        i.la.la-plus
                        |  Add Line

            // ACTION BAR
            .d-flex.justify-content-between.align-items-center.mb-3
              div
                button#btnAddLine.btn.btn-outline-brand.btn-sm(type="button")
                  i.la.la-eraser
                  |  Clear Form

              div.action-btns
                button#btnConfirmBill.btn.btn-success.btn-sm(type="button")
                  i.la.la-check
                  |  Confirm Bill

                button#btnCancelBill.btn.btn-danger.btn-sm(type="button")
                  i.la.la-close
                  |  Cancel Bill

                button#btnRevertBill.btn.btn-outline-warning.btn-sm.mr-2(type="button")
                  i.la.la-undo
                  |  Revert Bill
                  
            // LINES TABLE
            .table-responsive
              table#lineTable.table.table-striped.table-bordered.table-hover
                thead
                 tr
                    th(style="width:50px") #
                    th Article
                    th Brand
                    th Color
                    th(style="width:80px") Qty
                    th(style="width:110px") MRP
                    th(style="width:90px") Disc %
                    th(style="width:110px") Cost
                    th(style="width:120px") Amount
                    th Remarks
                    th(style="width:110px") Actions
                tbody
                  tr
                    td.text-center.text-muted(colspan="9") No lines added

          .modal-footer
            small.text-muted.mr-auto Confirming the bill will post stock into ledger and stop editing.
            button.btn.btn-secondary(type="button", data-dismiss="modal") Close
    // SCAN PREVIEW MODAL
    #modalScanPreview.modal.fade(role="dialog" tabindex="-1")
      .modal-dialog.modal-xl(role="document")
        .modal-content
          .modal-header
            h5.modal-title Scanned Bill Preview
            button.close(type="button", data-dismiss="modal", aria-label="Close")
              span(aria-hidden="true") ×

          .modal-body
            input#scan_preview_bill_id(type="hidden")

            .alert.alert-warning
              | Please verify scanned lines before importing. OCR can make mistakes.

            .table-responsive
              table#scanPreviewTable.table.table-bordered.table-striped
                thead
                  tr
                    th Use
                    th Brand
                    th Article
                    th Color
                    th Qty
                    th MRP
                    th Disc %
                    th Cost
                    th Amount
                    th Remarks
                tbody
                  tr
                    td.text-center.text-muted(colspan="10") No scanned lines

          .modal-footer
            button.btn.btn-secondary(type="button", data-dismiss="modal") Cancel
            button#btnImportScannedLines.btn.btn-success(type="button")
              i.la.la-upload
              |  Import Selected Lines

              
    #modalQuickArticle.modal.fade(role="dialog" tabindex="-1")
      .modal-dialog.modal-lg(role="document")
        .modal-content
          .modal-header
            h5.modal-title Add New Article
            button.close(type="button", data-dismiss="modal", aria-label="Close")
              span(aria-hidden="true") ×

          .modal-body
            form#quickArticleForm
              .row
                .col-md-6
                  .form-group
                    label.font-weight-bold Brand
                    input#qa_brand.form-control(type="text", placeholder="INDUS", required)

                .col-md-6
                  .form-group
                    label.font-weight-bold Article Name
                    input#qa_articleName.form-control(type="text", placeholder="EVG-N-CROSS-01", required)

              .row
                .col-md-6
                  .form-group
                    label.font-weight-bold Category Group
                    select#qa_categoryGroup.form-control(required)
                      option(value="") Select Group
                      option(value="MEN") MEN
                      option(value="WOMEN") WOMEN
                      option(value="KIDS") KIDS
                      option(value="UNISEX") UNISEX

                .col-md-6
                  .form-group
                    label.font-weight-bold Category
                    select#qa_category.form-control(required)
                      option(value="") Select Group First

              .form-group
                label Notes
                textarea#qa_notes.form-control(rows="2", placeholder="Optional")

          .modal-footer
            button.btn.btn-secondary(type="button", data-dismiss="modal") Cancel
            button#btnSaveQuickArticle.btn.btn-brand(type="submit", form="quickArticleForm")
              i.la.la-save
              |  Save Article
    
    #kt_scrolltop.kt-scrolltop
      i.fa.fa-arrow-up

    script.
      var KTAppOptions = {
        "colors": {
          "state": {
            "brand": "#5d78ff",
            "dark": "#282a3c",
            "light": "#ffffff",
            "primary": "#5867dd",
            "success": "#34bfa3",
            "info": "#36a3f7",
            "warning": "#ffb822",
            "danger": "#fd3995"
          },
          "base": {
            "label": ["#c5cbe3", "#a1a8c3", "#3d4465", "#3e4466"],
            "shape": ["#f0f3ff", "#d9dffa", "#afb4d4", "#646c9a"]
          }
        }
      };

    script(src="/assets/plugins/global/plugins.bundle.js" type="text/javascript")
    script(src="/assets/js/scripts.bundle.js" type="text/javascript")
    script(src="/assets/plugins/custom/datatables/datatables.bundle.js" type="text/javascript")
    script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
    script(src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js")
    script(src="/rpanel/js/footwear/su/stock-in-ui.js" type="text/javascript")