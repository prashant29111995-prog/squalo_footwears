doctype html
html(lang="en")
  include ../partials/head.pug

  body.kt-quick-panel--right.kt-demo-panel--right.kt-offcanvas-panel--right.kt-header--fixed.kt-header-mobile--fixed.kt-subheader--enabled.kt-subheader--fixed.kt-subheader--solid.kt-aside--enabled.kt-aside--fixed.kt-page--loading
    #kt_header_mobile.kt-header-mobile.kt-header-mobile--fixed
      .kt-header-mobile__logo
        a(href="index.html")
          img(
            alt="Logo"
            src="/assets/media/logos/logo-dark.png"
          )

      .kt-header-mobile__toolbar
        button#kt_aside_mobile_toggler.kt-header-mobile__toggler.kt-header-mobile__toggler--left(
          type="button"
        )
          span

        button#kt_header_mobile_toggler.kt-header-mobile__toggler(
          type="button"
        )
          span

        button#kt_header_mobile_topbar_toggler.kt-header-mobile__topbar-toggler(
          type="button"
        )
          i.flaticon-more

    .kt-grid.kt-grid--hor.kt-grid--root
      .kt-grid__item.kt-grid__item--fluid.kt-grid.kt-grid--ver.kt-page
        include ../partials/sidenav.pug

        #kt_wrapper.kt-grid__item.kt-grid__item--fluid.kt-grid.kt-grid--hor.kt-wrapper
          include ../partials/topnav.pug

          #kt_content.kt-content.kt-grid__item.kt-grid__item--fluid.kt-grid.kt-grid--hor
            include ../partials/header.pug

            .kt-container.kt-container--fluid.kt-grid__item.kt-grid__item--fluid
              .kt-portlet.kt-portlet--mobile
                .kt-portlet__head
                  .kt-portlet__head-label
                    h3.kt-portlet__head-title Stores & Staff

                  .kt-portlet__head-toolbar
                    button.btn.btn-brand.btn-sm(
                      type="button"
                      data-toggle="modal"
                      data-target="#modalStoreCreate"
                    )
                      i.la.la-plus
                      |  Add Store

                .kt-portlet__body
                  .alert.alert-light.mb-4
                    strong Setup order:
                    |  Link a store to its business workspace, then open
                    |  Staff & Logins to create individual POS accounts.

                  .row.align-items-center.mb-4
                    .col-lg-6
                      label(for="generalSearch") Search Stores
                      .kt-input-icon.kt-input-icon--left
                        input#generalSearch.form-control(
                          type="search"
                          placeholder="Search code, name, business or city..."
                        )
                        span.kt-input-icon__icon.kt-input-icon__icon--left
                          span
                            i.la.la-search

                    .col-lg-6.mt-3.mt-lg-0
                      small.text-muted
                        | Edit an existing store to link its workspace.
                        |  Its racks and stock retain their existing store reference.

                  table#storesTable.table.table-striped.table-bordered.table-hover(
                    style="width:100%"
                  )
                    thead
                      tr
                        th Code
                        th Name
                        th Business
                        th Type
                        th City
                        th Active
                        th Actions
                    tbody

          include ../partials/footer.pug

    //- Create store
    #modalStoreCreate.modal.fade(
      role="dialog"
      tabindex="-1"
      aria-labelledby="storeCreateTitle"
    )
      .modal-dialog.modal-lg(role="document")
        .modal-content
          .modal-header
            h5#storeCreateTitle.modal-title Add Store

            button.close(
              type="button"
              data-dismiss="modal"
              aria-label="Close"
            )
              span(aria-hidden="true") ×

          .modal-body
            form#storeCreateForm
              .form-group
                label(for="store_businessId") Business Workspace *
                select#store_businessId.form-control(required)
                  option(value="") Loading workspaces...

                small.form-text.text-muted
                  | Select the business that owns this store.
                  |  Create buying-party workspaces from the Parties screen.

              .row
                .col-md-6
                  .form-group
                    label(for="store_code") Store Code *
                    input#store_code.form-control(
                      type="text"
                      placeholder="DL-SHOP-01"
                      required
                    )
                    small.form-text.text-muted
                      | Store codes must be unique across the system.

                .col-md-6
                  .form-group
                    label(for="store_name") Store Name *
                    input#store_name.form-control(
                      type="text"
                      placeholder="Ballabhgarh Metro Store"
                      required
                    )

              .form-group
                label(for="store_type") Type
                select#store_type.form-control
                  option(value="RETAIL" selected) Retail Outlet
                  option(value="GODOWN") Godown
                  option(value="WAREHOUSE") Warehouse

              hr

              .form-group
                label(for="store_addr1") Address
                input#store_addr1.form-control(
                  type="text"
                  placeholder="Street / Market / Building"
                )

              .row
                .col-md-6
                  .form-group
                    label(for="store_city") City
                    input#store_city.form-control(
                      type="text"
                      placeholder="Faridabad"
                    )

                .col-md-6
                  .form-group
                    label(for="store_state") State
                    input#store_state.form-control(
                      type="text"
                      placeholder="Haryana"
                    )

              .form-group
                label(for="store_pincode") Pincode
                input#store_pincode.form-control(
                  type="text"
                  inputmode="numeric"
                  placeholder="121004"
                )

          .modal-footer
            button.btn.btn-secondary(
              type="button"
              data-dismiss="modal"
            ) Cancel

            button#btnCreateStore.btn.btn-brand(
              type="submit"
              form="storeCreateForm"
            ) Save Store

    //- Edit store and assign ownership
    #modalStoreEdit.modal.fade(
      role="dialog"
      tabindex="-1"
      aria-labelledby="storeEditTitle"
    )
      .modal-dialog.modal-lg(role="document")
        .modal-content
          .modal-header
            h5#storeEditTitle.modal-title Update Store

            button.close(
              type="button"
              data-dismiss="modal"
              aria-label="Close"
            )
              span(aria-hidden="true") ×

          .modal-body
            form#storeEditForm
              input#edit_store_id(type="hidden")

              .form-group
                label(for="edit_store_businessId") Business Workspace
                select#edit_store_businessId.form-control
                  option(value="") Select workspace

                small#storeOwnershipHelp.form-text.text-muted

              .row
                .col-md-6
                  .form-group
                    label(for="edit_store_code") Store Code *
                    input#edit_store_code.form-control(
                      type="text"
                      required
                    )

                .col-md-6
                  .form-group
                    label(for="edit_store_name") Store Name *
                    input#edit_store_name.form-control(
                      type="text"
                      required
                    )

              .row
                .col-md-6
                  .form-group
                    label(for="edit_store_type") Type
                    select#edit_store_type.form-control
                      option(value="RETAIL") Retail Outlet
                      option(value="GODOWN") Godown
                      option(value="WAREHOUSE") Warehouse

                .col-md-6
                  .form-group
                    label(for="edit_store_active") Status
                    select#edit_store_active.form-control
                      option(value="true") Active
                      option(value="false") Inactive

              hr

              .form-group
                label(for="edit_store_addr1") Address
                input#edit_store_addr1.form-control(type="text")

              .row
                .col-md-6
                  .form-group
                    label(for="edit_store_city") City
                    input#edit_store_city.form-control(type="text")

                .col-md-6
                  .form-group
                    label(for="edit_store_state") State
                    input#edit_store_state.form-control(type="text")

              .form-group
                label(for="edit_store_pincode") Pincode
                input#edit_store_pincode.form-control(
                  type="text"
                  inputmode="numeric"
                )

          .modal-footer
            button.btn.btn-secondary(
              type="button"
              data-dismiss="modal"
            ) Cancel

            button#btnUpdateStore.btn.btn-brand(
              type="submit"
              form="storeEditForm"
            ) Save Changes

    //- Business staff accounts
    #modalBusinessStaff.modal.fade(
      role="dialog"
      tabindex="-1"
      aria-labelledby="businessStaffTitle"
    )
      .modal-dialog.modal-lg(role="document")
        .modal-content
          .modal-header
            h5#businessStaffTitle.modal-title Staff & Logins

            button.close(
              type="button"
              data-dismiss="modal"
              aria-label="Close"
            )
              span(aria-hidden="true") ×

          .modal-body
            .p-3.mb-4(
              style="background:#f5f7ff;border:1px solid #e1e7ff;border-radius:10px"
            )
              h6#staffBusinessName.mb-2

              p.mb-1
                strong Workspace code:
                |  
                span#staffWorkspaceCode

              p.mb-0
                | POS login: 
                a(
                  href="/pos/login"
                  target="_blank"
                  rel="noopener"
                ) Open Staff Login

            #staffLoadMessage.alert.alert-info(
              role="status"
              aria-live="polite"
            ) Loading staff...

            button#staffRetry.btn.btn-outline-brand.btn-sm.mb-3.d-none(
              type="button"
            ) Retry Loading

            h6.mb-3 Existing Staff

            .table-responsive
              table.table.table-bordered
                thead
                  tr
                    th Staff
                    th Role
                    th Store Access
                    th Status
                tbody#staffTableBody

            hr.my-4

            h6 Create Staff Login
            p.text-muted
              | Create the Owner first. Each person should have a separate login.
              |  This list includes staff across the selected business.

            form#staffCreateForm
              .row
                .col-md-6
                  .form-group
                    label(for="staff_name") Full Name *
                    input#staff_name.form-control(
                      type="text"
                      required
                      maxlength="150"
                    )

                .col-md-6
                  .form-group
                    label(for="staff_email") Email *
                    input#staff_email.form-control(
                      type="email"
                      required
                      maxlength="254"
                      autocomplete="off"
                    )

              .row
                .col-md-6
                  .form-group
                    label(for="staff_phone") Phone *
                    input#staff_phone.form-control(
                      type="tel"
                      required
                      pattern="[1-9][0-9]{6,14}"
                      maxlength="15"
                      placeholder="Digits only, without a leading zero"
                      autocomplete="off"
                    )

                .col-md-6
                  .form-group
                    label(for="staff_role") Role *
                    select#staff_role.form-control(required)
                      option(value="OWNER") Owner
                      option(value="MANAGER") Manager
                      option(value="CASHIER") Cashier
                      option(value="SALESPERSON") Salesperson
                      option(value="STOCKIST") Stockist

              .form-group
                label(for="staff_storeAccess") Store Access
                select#staff_storeAccess.form-control
                  option(value="ASSIGNED") Selected stores only
                  option(value="ALL") All stores in this business

                small.form-text.text-muted
                  | Business-wide access is available only to Owners and Managers.

              .form-group#staffAssignedGroup
                label(for="staff_storeIds") Assigned Stores
                select#staff_storeIds.form-control(
                  multiple
                  size="4"
                )

                small.form-text.text-muted
                  | Hold Ctrl to select multiple stores on Windows.

              .form-group
                label(for="staff_defaultStoreId") Default Store
                select#staff_defaultStoreId.form-control
                  option(value="") No default store

              .form-group
                label(for="staff_password") Temporary Password *
                input#staff_password.form-control(
                  type="password"
                  required
                  minlength="10"
                  autocomplete="new-password"
                )

                small.form-text.text-muted
                  | Use at least 10 characters with a letter and a number.
                  |  The staff member must change this password after first login.

              #staffCreateError.alert.alert-danger.d-none(
                role="alert"
                aria-live="assertive"
              )

          .modal-footer
            button.btn.btn-secondary(
              type="button"
              data-dismiss="modal"
            ) Close

            button#btnCreateStaff.btn.btn-brand(
              type="submit"
              form="staffCreateForm"
              disabled
            ) Create Staff Login

    #kt_scrolltop.kt-scrolltop
      i.fa.fa-arrow-up

    script(
      src="/assets/plugins/global/plugins.bundle.js"
      type="text/javascript"
    )
    script(
      src="/assets/js/scripts.bundle.js"
      type="text/javascript"
    )
    script(
      src="/assets/plugins/custom/datatables/datatables.bundle.js"
      type="text/javascript"
    )
    script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")

    //- Load only the updated Stores JavaScript.
    script(
      src="/rpanel/js/footwear/su/stores-ui.js"
      type="text/javascript"
    )