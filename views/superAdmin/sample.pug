doctype html
html(lang="en")
  include ./partials/head.pug
  style.
    #loading {
    background: url('/../Rolling-1.4s-71px.gif') no-repeat center center;
    position: absolute;
    top: 0;
    left: 0;
    height: 10em;
    width: 10em;
    z-index: 9999999;
    }

  body.kt-quick-panel--right.kt-demo-panel--right.kt-offcanvas-panel--right.kt-header--fixed.kt-header-mobile--fixed.kt-subheader--enabled.kt-subheader--fixed.kt-subheader--solid.kt-aside--enabled.kt-aside--fixed.kt-page--loading
    // begin:: Page
    // begin:: Header Mobile
    #kt_header_mobile.kt-header-mobile.kt-header-mobile--fixed
      .kt-header-mobile__logo
        a(href="index.html")
          img(alt="Logo" src="/assets/media/logos/logo-dark.png")
      .kt-header-mobile__toolbar
        button#kt_aside_mobile_toggler.kt-header-mobile__toggler.kt-header-mobile__toggler--left
          span
        button#kt_header_mobile_toggler.kt-header-mobile__toggler
          span
        button#kt_header_mobile_topbar_toggler.kt-header-mobile__topbar-toggler
          i.flaticon-more
    // end:: Header Mobile
    .kt-grid.kt-grid--hor.kt-grid--root
      .kt-grid__item.kt-grid__item--fluid.kt-grid.kt-grid--ver.kt-page
        include ./partials/sidenav.pug
        #kt_wrapper.kt-grid__item.kt-grid__item--fluid.kt-grid.kt-grid--hor.kt-wrapper
          // begin:: Header
          include ./partials/topnav.pug
          #kt_content.kt-content.kt-grid__item.kt-grid__item--fluid.kt-grid.kt-grid--hor
            // begin:: Content Head
            include ./partials/header.pug
            .kt-container.kt-container--fluid.kt-grid__item.kt-grid__item--fluid
              // Begin::Dashboard 3
              // Begin::Row
              .kt-portlet.kt-portlet--mobile
                .kt-portlet__head
                  .kt-portlet__head-label
                    h3.kt-portlet__head-title
                      | Warehouse Inventory
                  .kt-portlet__head-toolbar
                    .kt-portlet__head-toolbar-wrapper
                      
                      .dropdown.dropdown-inline
                        
                        button.btn.btn-outline-brand.btn-sm(type='button', style="margin-right:0.5rem;", data-toggle='dropdown', aria-haspopup='true', aria-expanded='false')
                          i.la.la-download
                          |  Export
                        .dropdown-menu.dropdown-menu-right
                          ul.kt-nav
                            li.kt-nav__section.kt-nav__section--first
                              span.kt-nav__section-text Export Tools
                            li.kt-nav__item
                              a#export_print.kt-nav__link(href='#')
                                i.kt-nav__link-icon.la.la-print
                                span.kt-nav__link-text Print
                            li.kt-nav__item
                              a#export_copy.kt-nav__link(href='#')
                                i.kt-nav__link-icon.la.la-copy
                                span.kt-nav__link-text Copy
                            li.kt-nav__item
                              a#export_excel.kt-nav__link(href='#')
                                i.kt-nav__link-icon.la.la-file-excel-o
                                span.kt-nav__link-text Excel
                            li.kt-nav__item
                              a#export_csv.kt-nav__link(href='#')
                                i.kt-nav__link-icon.la.la-file-text-o
                                span.kt-nav__link-text CSV
                            li.kt-nav__item
                              a#export_pdf.kt-nav__link(href='#')
                                i.kt-nav__link-icon.la.la-file-pdf-o
                                span.kt-nav__link-text PDF
                        button.btn.btn-brand.btn-sm(type="button", data-toggle="modal", data-target="#addArticleModal")
                          i.la.la-plus
                          |  Add Article
                #addTable.kt-portlet__body(style="padding-top:0")
                  .kt-form.kt-form--label-right.kt-margin-t-20.kt-margin-b-10
                      .row.align-items-center
                        .col-xl-8.order-2.order-xl-1
                          .row.align-items-center
                            .col-md-4.kt-margin-b-20-tablet-and-mobile
                              .kt-input-icon.kt-input-icon--left
                                input#generalSearch.form-control(type='text', placeholder='Search...')
                                span.kt-input-icon__icon.kt-input-icon__icon--left
                                  span
                                    i.la.la-search
                  // begin: Datatable
                  .row.mb-3
                    .col-md-3
                      label Brand
                      select#filterBrand.form-control
                        option(value="") All
                        option(value="CLD") CLD
                        option(value="INDUS") INDUS
                        option(value="SPARX") SPARX

                    .col-md-3
                      label Location
                      select#filterLocation.form-control
                        option(value="") All
                        option(value="Basement") Basement
                        option(value="Shop") Shop

                    .col-md-3
                      label Size
                      select#filterSize.form-control
                        option(value="") All
                        option(value="6") 6
                        option(value="7") 7
                        option(value="8") 8
                        option(value="9") 9
                        option(value="10") 10

                    .col-md-3
                      label Color
                      input#filterColor.form-control(type="text" placeholder="BLK/WHT")

                  table#kt_table_3.table.table-striped.table-bordered.table-hover.table-checkable
                    thead
                      tr
                        th Brand
                        th Article
                        th Color
                        th Size
                        th Quantity
                        th Location
                    tbody
          include ./partials/footer.pug
          // end::Modal
          // begin::Modal
      
      #addArticleModal.modal.fade(role="dialog" tabindex="-1")
        .modal-dialog.modal-lg(role="document")
          .modal-content
            .modal-header
              h5.modal-title Add Article (Inventory Entry)
              button.close(type="button", data-dismiss="modal" aria-label="Close")
                span(aria-hidden="true") ×
            .modal-body
              form#addArticleForm
                .row
                  .col-lg-4
                    .form-group
                      label Brand
                      select#brand.form-control(required)
                        option(value="" disabled selected) Select brand
                        option(value="CLD") CLD
                        option(value="INDUS") INDUS
                        option(value="SPARX") SPARX
                        // add more

                  .col-lg-4
                    .form-group
                      label Article Name
                      input#articleName.form-control(type="text" placeholder="e.g., WINFLOW-1" required)

                  .col-lg-4
                    .form-group
                      label Location
                      select#location.form-control(required)
                        option(value="Basement") Basement
                        option(value="Shop") Shop
                hr
                .row
                  .col-lg-6
                    label Colors
                    .input-group
                      input#colorInput.form-control(type="text" placeholder="e.g., BLK/WHT")
                      .input-group-append
                        button#addColorBtn.btn.btn-outline-brand(type="button") + Add
                    small.form-text.text-muted Add multiple colors like BLK/WHT, WHT/PGRN
                    #colorChips.mt-2

                  .col-lg-6
                    label Sizes
                    .input-group
                      input#sizeInput.form-control(type="number" placeholder="e.g., 6" min="1")
                      .input-group-append
                        button#addSizeBtn.btn.btn-outline-brand(type="button") + Add
                    small.form-text.text-muted Add sizes like 6,7,8,9,10
                    #sizeChips.mt-2
                hr
                h6 Quantity Matrix
                .kt-scroll(style="max-height:320px; overflow:auto; border:1px solid #eef1f5; border-radius:6px;")
                  table.table.table-bordered.mb-0
                    thead
                      tr
                        th(style="min-width:160px") Color \ Size
                        // sizes header injected by JS
                    tbody#qtyMatrixBody
                      // rows injected by JS
            .modal-footer
              button.btn.btn-secondary(type="button", data-dismiss="modal") Cancel
              button#saveArticleBtn.btn.btn-brand(type="submit", form="addArticleForm") Save Article
      // SKU EDIT MODAL (single sku)
      #modalSkuEdit.modal.fade(role="dialog" tabindex="-1")
        .modal-dialog.modal-md(role="document")
          .modal-content
            .modal-header
              h5.modal-title Update SKU
              button.close(type="button", data-dismiss="modal" aria-label="Close")
                span(aria-hidden="true") ×

            .modal-body
              // hidden id
              input#sku_id(type="hidden")

              .form-group
                label Brand
                input#sku_brand.form-control(type="text" readonly)

              .form-group
                label Article
                input#sku_article.form-control(type="text" readonly)

              .row
                .col-md-6
                  .form-group
                    label Color
                    input#sku_color.form-control(type="text" placeholder="BLK/WHT")
                .col-md-6
                  .form-group
                    label Size
                    input#sku_size.form-control(type="text" placeholder="10")

              .row
                .col-md-6
                  .form-group
                    label Location
                    select#sku_location.form-control
                      option(value="Basement") Basement
                      option(value="Shop") Shop
                .col-md-6
                  .form-group
                    label Quantity
                    input#sku_quantity.form-control(type="number" min="0")

              small.form-text.text-muted
                | Clicking Color/Size/Quantity/Location in table edits this SKU only.

            .modal-footer
              button.btn.btn-secondary(type="button", data-dismiss="modal") Cancel
              button#btnSkuSave.btn.btn-brand(type="button") Update SKU

      // PRODUCT BULK EDIT MODAL (all SKUs under one product)
      #modalProductEdit.modal.fade(role="dialog" tabindex="-1")
        .modal-dialog.modal-md(role="document")
          .modal-content
            .modal-header
              h5.modal-title Update Product (All SKUs)
              button.close(type="button", data-dismiss="modal" aria-label="Close")
                span(aria-hidden="true") ×

            .modal-body
              .form-group
                label Brand
                input#prod_brand.form-control(type="text" readonly)

              .form-group
                label Article
                input#prod_article.form-control(type="text" readonly)

              hr

              .form-group
                label Move ALL SKUs to Location
                select#prod_location.form-control
                  option(value="Basement") Basement
                  option(value="Shop") Shop

              small.form-text.text-muted
                | Clicking Brand/Article in table will open this. This will update all sizes/colors for the selected product.

            .modal-footer
              button.btn.btn-secondary(type="button", data-dismiss="modal") Cancel
              button#btnProductSave.btn.btn-brand(type="button") Update Product

    #kt_scrolltop.kt-scrolltop
      i.fa.fa-arrow-up
    script.
      var KTAppOptions = {
      "colors": {
      "state": {
      "brand": "#5d78ff",
      "dark": "#282a3c",
      "light": "#ffffff",
      "primary": "#5867dd",
      "success": "#34bfa3",
      "info": "#36a3f7",
      "warning": "#ffb822",
      "danger": "#fd3995"
      },
      "base": {
      "label": [
      "#c5cbe3",
      "#a1a8c3",
      "#3d4465",
      "#3e4466"
      ],
      "shape": [
      "#f0f3ff",
      "#d9dffa",
      "#afb4d4",
      "#646c9a"
      ]
      }
      }
      };
